#!/bin/sh
# pre-commit: 仅在改动含 *.cs 时跑 dotnet format 校验，失败阻塞提交
has_cs=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.cs$' || true)
if [ -z "$has_cs" ]; then
  exit 0
fi
if ! command -v dotnet >/dev/null 2>&1; then
  echo "⚠️  dotnet 未安装，跳过 format 校验"
  exit 0
fi
echo "▶ dotnet format --verify-no-changes ..."
if ! dotnet format --verify-no-changes --verbosity quiet 2>&1 | head -n 50; then
  echo "❌ dotnet format 校验失败，请执行: dotnet format"
  echo "   (仅本次跳过: git commit --no-verify)"
  exit 1
fi
